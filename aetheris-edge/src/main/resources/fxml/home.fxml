<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.image.ImageView?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.agent.aetheris.presentation.controller.HomeController"
           stylesheets="@../css/home.css"
           styleClass="root-container"
           prefWidth="700" prefHeight="500">

    <!-- Layer 1: Particle Background Canvas -->
    <Canvas fx:id="particleCanvas" />

    <!-- Layer 2: Main Application Content -->
    <BorderPane styleClass="content-layer">
        <top>
            <Pane styleClass="title-bar" prefHeight="40.0" BorderPane.alignment="CENTER">
                <children>
                    <!-- App icon + title (left) -->
                    <ImageView fx:id="appIcon" fitHeight="19.0" fitWidth="25.0"
                               layoutX="14.0" layoutY="10.0"
                               pickOnBounds="true" preserveRatio="true" />
                    <Label layoutX="46.0" layoutY="11.0" text="Aetheris Edge"
                           styleClass="title-bar-text" />

                    <!-- Window controls (right) -->
                    <Button fx:id="btnMinimize" layoutX="601.0" layoutY="8.0"
                            mnemonicParsing="false" text="─"
                            styleClass="window-btn window-btn-minimize"
                            onAction="#handleMinimize" />
                    <Button fx:id="btnMaximize" layoutX="631.0" layoutY="8.0"
                            mnemonicParsing="false" text="□"
                            styleClass="window-btn window-btn-maximize"
                            onAction="#handleMaximize" />
                    <Button fx:id="btnClose" layoutX="661.0" layoutY="8.0"
                            mnemonicParsing="false" text="✕"
                            styleClass="window-btn window-btn-close"
                            onAction="#handleClose" />
 

                </children>
            </Pane>
        </top>
        <left>
            <Pane styleClass="edge-padding" prefWidth="25.0" BorderPane.alignment="CENTER" />
        </left>
        <right>
            <Pane styleClass="edge-padding" prefWidth="25.0" BorderPane.alignment="CENTER" />
        </right>
        <bottom>
            <Pane styleClass="edge-padding-bottom" prefHeight="25.0" BorderPane.alignment="CENTER" />
        </bottom>
        <center>
            <Pane fx:id="contentArea" styleClass="content-area" BorderPane.alignment="CENTER" />
        </center>
    </BorderPane>

</StackPane>