<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.shape.Circle?>
<?import javafx.geometry.Insets?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.agent.aetheris.presentation.controller.HomeController"
           stylesheets="@../css/home.css"
           styleClass="root-container"
           prefWidth="800" prefHeight="600">

    <!-- Layer 1: Particle Background Canvas -->
    <Canvas fx:id="particleCanvas" />

    <!-- Layer 2: Main Application Content -->
    <BorderPane styleClass="content-layer">
        
        <!-- TITLE BAR -->
        <top>
            <fx:include source="components/title_bar.fxml" />
        </top>

        <!-- MAIN CONTENT -->
        <center>
            <HBox spacing="15" BorderPane.alignment="CENTER">
                <padding><Insets top="5" right="15" bottom="15" left="15" /></padding>
                
                <!-- LEFT COLUMN -->
                <VBox HBox.hgrow="ALWAYS" spacing="15">
                    
                    <!-- Top Control Bar -->
                    <HBox fx:id="comPortBox" styleClass="panel-card" alignment="CENTER_LEFT" spacing="15">
                        <padding><Insets top="15" right="15" bottom="15" left="15" /></padding>

                        <ComboBox fx:id="comPortCombo" styleClass="pill-combo" promptText="COM 8" prefWidth="130" />
                        <Button fx:id="resetButton" styleClass="circle-icon-btn">
                            <graphic>
                                <ImageView fitHeight="14.0" fitWidth="14.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../assets/home/reset.png" />
                                    </image>
                                </ImageView>
                            </graphic>
                        </Button>
                        <Button fx:id="autodetectButton" text="Auto Detect Port" styleClass="pill-button" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="playButton" styleClass="circle-icon-btn">
                            <graphic>
                                <ImageView fitHeight="14.0" fitWidth="14.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../assets/home/home-play.png" />
                                    </image>
                                </ImageView>
                            </graphic>
                        </Button>
                        <Button fx:id="stopButton" styleClass="circle-icon-btn">
                            <graphic>
                                <ImageView fitHeight="14.0" fitWidth="14.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../assets/home/home-stop.png" />
                                    </image>
                                </ImageView>
                            </graphic>
                        </Button>
                    </HBox>
                    
                    <!-- Gauges Panel -->
                    <VBox fx:id="gaugesBox" styleClass="panel-card" VBox.vgrow="ALWAYS" alignment="CENTER" spacing="30">
                        <padding><Insets top="15" right="15" bottom="15" left="15" /></padding>
                        
                        <HBox alignment="CENTER" spacing="35">
                            <!-- Gauge 1 -->
                            <VBox alignment="CENTER" spacing="15">
                                <StackPane styleClass="gauge-wrapper">
                                    <Circle radius="70" styleClass="gauge-track" />
                                    <VBox alignment="CENTER" spacing="-2">
                                        <Label fx:id="seeingValueLabel" text="0" styleClass="gauge-value" />
                                        <Label text="ArcSec" styleClass="gauge-unit" />
                                    </VBox>
                                </StackPane>
                                <Label text="Seeing" styleClass="gauge-label" />
                            </VBox>
                            
                            <!-- Gauge 2 -->
                            <VBox alignment="CENTER" spacing="15">
                                <StackPane styleClass="gauge-wrapper">
                                    <Circle radius="70" styleClass="gauge-track" />
                                    <VBox alignment="CENTER" spacing="-2">
                                        <Label fx:id="inputVoltageValueLabel" text="0" styleClass="gauge-value" />
                                        <Label text="Volts" styleClass="gauge-unit" />
                                    </VBox>
                                </StackPane>
                                <Label text="Input" styleClass="gauge-label" />
                            </VBox>
                            
                            <!-- Gauge 3 -->
                            <VBox alignment="CENTER" spacing="15">
                                <StackPane styleClass="gauge-wrapper">
                                    <Circle radius="70" styleClass="gauge-track" />
                                    <VBox alignment="CENTER" spacing="-2">
                                        <Label fx:id="temperatureValueLabel" text="0" styleClass="gauge-value" />
                                        <Label text="°C" styleClass="gauge-unit" />
                                    </VBox>
                                </StackPane>
                                <Label text="Temp" styleClass="gauge-label" />
                            </VBox>
                        </HBox>
                        
                        <Button text="View Analytics &amp; Predictions" styleClass="cta-button" />
                    </VBox>

                    <!-- stats panel -->
                    <fx:include fx:id="statsPanelBox" source="components/weather_stats.fxml" />
                    
                    
                    <!-- Bottom Status -->
                    <HBox fx:id="statusPillBox" styleClass="status-pill" alignment="CENTER_LEFT" spacing="15" prefHeight="35" maxWidth="Infinity">
                        <HBox alignment="CENTER_LEFT" spacing="10" styleClass="status-pill-box-left" HBox.hgrow="ALWAYS">
                            <Circle fx:id="statusDot" radius="5" styleClass="status-dot" />
                            <Label fx:id="statusText" text="Device is Connected" styleClass="status-text" />
                        </HBox>
                        <HBox alignment="CENTER" spacing="8" styleClass="status-pill-box-right" prefWidth="150">
                            <ImageView fitHeight="18.0" fitWidth="18.0" pickOnBounds="true" preserveRatio="true">
                                <image>
                                    <Image url="@../assets/weather/autumn.png" />
                                </image>
                            </ImageView>
                            <Label text="Partly Cloudy" styleClass="weather-status-text" />
                        </HBox>
                    </HBox>
                </VBox>
                
                <!-- RIGHT COLUMN (Sidebar + Weather) -->
                <VBox spacing="15" prefWidth="75" maxWidth="75">
                    <VBox fx:id="sidebarCardBox" styleClass="sidebar-card" prefHeight="362" alignment="TOP_CENTER" spacing="18">
                        <padding><Insets top="12" right="10" bottom="12" left="10" /></padding>
                        <Button styleClass="sidebar-icon-btn">
                            <graphic>
                                <ImageView fitHeight="25.0" fitWidth="25.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../assets/home/home-gear.png" />
                                    </image>
                                </ImageView>
                            </graphic>
                        </Button>
                        <Button styleClass="sidebar-icon-btn">
                            <graphic>
                                <ImageView fitHeight="25.0" fitWidth="25.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../assets/home/home-mini.png" />
                                    </image>
                                </ImageView>
                            </graphic>
                        </Button>
                        <Button styleClass="sidebar-icon-btn">
                            <graphic>
                                <ImageView fitHeight="25.0" fitWidth="25.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../assets/home/home-lock.png" />
                                    </image>
                                </ImageView>
                            </graphic>
                        </Button>
                        <Button styleClass="sidebar-icon-btn">
                            <graphic>
                                <ImageView fitHeight="25.0" fitWidth="25.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../assets/home/github.png" />
                                    </image>
                                </ImageView>
                            </graphic>
                        </Button>
                        <Button styleClass="sidebar-icon-btn">
                            <graphic>
                                <ImageView fitHeight="25.0" fitWidth="25.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../assets/home/internet.png" />
                                    </image>
                                </ImageView>
                            </graphic>
                        </Button>
                    </VBox>
                    
                    <!-- video card -->
                    <fx:include fx:id="weatherCardBox" source="components/video_card.fxml" />
                </VBox>
            </HBox>
        </center>
    </BorderPane>

</StackPane>