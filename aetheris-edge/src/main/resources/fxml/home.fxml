<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.shape.Circle?>
<?import javafx.geometry.Insets?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.agent.aetheris.presentation.controller.HomeController"
           stylesheets="@../css/home.css"
           styleClass="root-container"
           prefWidth="700" prefHeight="500">

    <!-- Layer 1: Particle Background Canvas -->
    <Canvas fx:id="particleCanvas" />

    <!-- Layer 2: Main Application Content -->
    <BorderPane styleClass="content-layer">
        
        <!-- TITLE BAR -->
        <top>
            <fx:include source="title_bar.fxml" />
        </top>

        <!-- MAIN CONTENT -->
        <center>
            <HBox spacing="15" BorderPane.alignment="CENTER">
                <padding><Insets top="5" right="15" bottom="15" left="15" /></padding>
                
                <!-- LEFT COLUMN -->
                <VBox HBox.hgrow="ALWAYS" spacing="15">
                    
                    <!-- Top Control Bar -->
                    <HBox fx:id="comPortBox" styleClass="panel-card" alignment="CENTER_LEFT" spacing="15">
                        <padding><Insets top="15" right="15" bottom="15" left="15" /></padding>

                        <ComboBox fx:id="comPortCombo" styleClass="pill-combo" promptText="COM 8" prefWidth="130" />
                        <Button text="Auto Detect Port" styleClass="pill-button" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button styleClass="circle-icon-btn">
                            <graphic>
                                <ImageView fitHeight="14.0" fitWidth="14.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../assets/home/home-play.png" />
                                    </image>
                                </ImageView>
                            </graphic>
                        </Button>
                        <Button styleClass="circle-icon-btn">
                            <graphic>
                                <ImageView fitHeight="14.0" fitWidth="14.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../assets/home/home-stop.png" />
                                    </image>
                                </ImageView>
                            </graphic>
                        </Button>
                    </HBox>
                    
                    <!-- Gauges Panel -->
                    <VBox fx:id="gaugesBox" styleClass="panel-card" VBox.vgrow="ALWAYS" alignment="CENTER" spacing="25">
                        <padding><Insets top="20" right="20" bottom="20" left="20" /></padding>
                        
                        <HBox alignment="CENTER" spacing="35">
                            <!-- Gauge 1 -->
                            <VBox alignment="CENTER" spacing="15">
                                <StackPane styleClass="gauge-wrapper">
                                    <Circle radius="60" styleClass="gauge-track" />
                                    <VBox alignment="CENTER" spacing="-5">
                                        <Label text="5.4" styleClass="gauge-value" />
                                        <Label text="ArcSec" styleClass="gauge-unit" />
                                    </VBox>
                                </StackPane>
                                <Label text="Seeing" styleClass="gauge-label" />
                            </VBox>
                            
                            <!-- Gauge 2 -->
                            <VBox alignment="CENTER" spacing="15">
                                <StackPane styleClass="gauge-wrapper">
                                    <Circle radius="60" styleClass="gauge-track" />
                                    <VBox alignment="CENTER" spacing="-5">
                                        <Label text="0.03" styleClass="gauge-value" />
                                        <Label text="Volts" styleClass="gauge-unit" />
                                    </VBox>
                                </StackPane>
                                <Label text="Input" styleClass="gauge-label" />
                            </VBox>
                            
                            <!-- Gauge 3 -->
                            <VBox alignment="CENTER" spacing="15">
                                <StackPane styleClass="gauge-wrapper">
                                    <Circle radius="60" styleClass="gauge-track" />
                                    <VBox alignment="CENTER" spacing="-5">
                                        <Label text="5.4" styleClass="gauge-value" />
                                        <Label text="C" styleClass="gauge-unit" />
                                    </VBox>
                                </StackPane>
                                <Label text="Temp" styleClass="gauge-label" />
                            </VBox>
                        </HBox>
                        
                        <Button text="View Analytics &amp; Predictions" styleClass="cta-button" />
                    </VBox>
                    
                    <!-- Bottom Status -->
                    <HBox fx:id="statusPillBox" styleClass="status-pill" alignment="CENTER_LEFT" spacing="8" prefHeight="35" maxWidth="Infinity">
                        <Circle radius="5" styleClass="status-dot" />
                        <Label text="Device is Connected" styleClass="status-text" />
                    </HBox>
                    
                </VBox>
                
                <!-- RIGHT COLUMN (Sidebar + Weather) -->
                <VBox spacing="15" prefWidth="60">
                    <VBox fx:id="sidebarCardBox" styleClass="sidebar-card" prefHeight="360" alignment="TOP_CENTER" spacing="16">
                        <padding><Insets top="12" right="10" bottom="12" left="10" /></padding>
                        <Button styleClass="sidebar-icon-btn">
                            <graphic>
                                <ImageView fitHeight="18.0" fitWidth="18.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../assets/home/home-wifi.png" />
                                    </image>
                                </ImageView>
                            </graphic>
                        </Button>
                        <Button styleClass="sidebar-icon-btn">
                            <graphic>
                                <ImageView fitHeight="18.0" fitWidth="18.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../assets/home/home-gear.png" />
                                    </image>
                                </ImageView>
                            </graphic>
                        </Button>
                        <Button styleClass="sidebar-icon-btn">
                            <graphic>
                                <ImageView fitHeight="18.0" fitWidth="18.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../assets/home/home-mini.png" />
                                    </image>
                                </ImageView>
                            </graphic>
                        </Button>
                        <Button styleClass="sidebar-icon-btn">
                            <graphic>
                                <ImageView fitHeight="18.0" fitWidth="18.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../assets/home/home-lock.png" />
                                    </image>
                                </ImageView>
                            </graphic>
                        </Button>
                        <Button styleClass="sidebar-icon-btn">
                            <graphic>
                                <ImageView fitHeight="18.0" fitWidth="18.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../assets/home/home-light.png" />
                                    </image>
                                </ImageView>
                            </graphic>
                        </Button>
                        <Button styleClass="sidebar-icon-btn">
                            <graphic>
                                <ImageView fitHeight="18.0" fitWidth="18.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../assets/home/home-light.png" />
                                    </image>
                                </ImageView>
                            </graphic>
                        </Button>
                    </VBox>
                    <HBox fx:id="temperatureBox" alignment="TOP_LEFT" prefHeight="60">
                        <StackPane prefHeight="60" prefWidth="60" alignment="TOP_LEFT">
                            <!-- Overlay Temperature at bottom or center -->
                            <HBox alignment="CENTER" StackPane.alignment="CENTER">
                                <Label text="20" styleClass="weather-temp" />
                                <Label text="℃" styleClass="weather-temp-unit" />
                            </HBox>
                        </StackPane>
                    </HBox>
                </VBox>
            </HBox>
        </center>
    </BorderPane>

</StackPane>